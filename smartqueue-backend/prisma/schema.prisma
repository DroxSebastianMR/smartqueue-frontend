generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QueueStatus {
  WAITING
  ADMITTED
  RESERVED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum ControlMode {
  FIXED
  REACTIVE
  PREDICTIVE
}

model Event {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String
  startsAt      DateTime
  capacity      Int
  availableStock Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  queueEntries  QueueEntry[]
  reservations  PurchaseReservation[]
  purchases     Purchase[]
}

model QueueEntry {
  id             String      @id @default(uuid())
  eventId        String
  participantToken String
  turnNumber     BigInt
  status         QueueStatus @default(WAITING)
  admittedAt     DateTime?
  accessExpiresAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  event          Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservation    PurchaseReservation?
  purchase       Purchase?

  @@unique([eventId, participantToken])
  @@unique([eventId, turnNumber])
  @@index([eventId, status, turnNumber])
}

model PurchaseReservation {
  id           String            @id @default(uuid())
  eventId      String
  queueEntryId String            @unique
  quantity     Int
  status       ReservationStatus @default(ACTIVE)
  expiresAt    DateTime
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  event        Event             @relation(fields: [eventId], references: [id])
  queueEntry   QueueEntry        @relation(fields: [queueEntryId], references: [id])
  purchase     Purchase?
}

model Purchase {
  id            String              @id @default(uuid())
  eventId       String
  queueEntryId  String              @unique
  reservationId String              @unique
  quantity      Int
  confirmationCode String           @unique
  createdAt     DateTime            @default(now())
  event         Event               @relation(fields: [eventId], references: [id])
  queueEntry    QueueEntry          @relation(fields: [queueEntryId], references: [id])
  reservation   PurchaseReservation @relation(fields: [reservationId], references: [id])
}

model ExperimentRun {
  id             String       @id @default(uuid())
  scenario       String
  seed           Int
  generatorVersion String
  controlMode    ControlMode
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  metricWindows  MetricWindow[]
}

model MetricWindow {
  id              String   @id @default(uuid())
  runId           String
  windowEnd       DateTime
  arrivalRate     Float
  arrivalTrend    Float
  queueLength     Int
  activeBuyers    Int
  admissionLimit  Int
  latencyP95Ms    Float
  errorRate       Float
  completionRate  Float
  evaluable       Boolean  @default(true)
  saturationLabel Boolean?
  run             ExperimentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  prediction      PredictionLog?

  @@unique([runId, windowEnd])
}

model PredictionLog {
  id               String   @id @default(uuid())
  metricWindowId   String   @unique
  riskScore        Float?
  riskClass        String?
  horizonSeconds   Int?
  modelVersion     String?
  requestedAt      DateTime @default(now())
  responseMs       Int?
  fallbackUsed     Boolean  @default(false)
  appliedMode      ControlMode
  appliedLimit     Int
  failureReason    String?
  metricWindow     MetricWindow @relation(fields: [metricWindowId], references: [id], onDelete: Cascade)
}

